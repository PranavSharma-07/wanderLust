<% layout("/layouts/boilerplate") %>

    <style>
        #filters {
            display: flex;
            align-items: center;
            gap: 1.8rem;
            padding: 0.5rem 0;
        }

        .filter {
            min-width: 55px;
            text-align: center;
            opacity: 0.65;
            transition: opacity 0.2s ease, transform 0.2s ease;
            cursor: pointer;
        }

        .filter:hover {
            opacity: 1;
            transform: translateY(-2px);
        }

        .filter i {
            font-size: 1.2rem;
        }

        .filter p {
            margin: 0.35rem 0 0;
            font-size: 0.8rem;
            white-space: nowrap;
        }

        .tax-toggle {
            margin-left: auto;
            border: 1px solid #ddd;
            border-radius: 1.5rem;
            padding: 0.65rem 1rem;
            height: auto;
            white-space: nowrap;
            background-color: #fff;
        }

        .tax-toggle .form-check {
            margin: 0;
        }

        .tax-toggle .form-check-input {
            cursor: pointer;
        }

        .tax-toggle .form-check-label {
            cursor: pointer;
            font-size: 0.9rem;
        }
    </style>

    <!-- <h2>All Listings</h2> -->
    <!-- <form method="GET" action="/listings/new">
        <button>Create new Listing</button>
    </form> -->
    <div id="filters" class="mt-4">
        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic cities</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain-sun"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-umbrella-beach"></i></div>
            <p>Beach</p>
        </div>
        <div class="filter">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-wifi"></i></div>
            <p>Wifi</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Arctic</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-kitchen-set"></i></div>
            <p>Kitchen</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing pool</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-tractor"></i></div>
            <p>Farm house</p>
        </div>
        <div class="tax-toggle">
            <div class="form-check form-switch form-check-reverse">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display Taxes</label>
            </div>
        </div>
    </div>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">

    <% for(let list of allListings){ %>
    <div class="col-md-4 mb-4">
    <a href="/listings/<%= list._id %>" class="listing-links">
        <div class="card listing-card">
            <img src="<%= list.image.url %>" class="card-img-top listing-img" alt="listing_image">

            <div class="card-body">
                <p class="card-text">
                    <%= list.title %><br>
                   <% if(list.price != null){ %>
                        <strong>&#8377; <%= list.price.toLocaleString("en-IN") %></strong> / night
                        <i class="tax-info"> &nbsp; +18%GST</i>
                    <% } else { %>
                        <strong>Price Not Available</strong>
                    <% } %>
                </p>
            </div>
        </div>
        </a>
    </div>

    <% } %>

</div>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");
        for(info of taxInfo){
            if(info.style.display != "inline"){
            info.style.display = "inline";
            }else{
            info.style.display = "none";
        }
        }

    })
</script>