<% layout("/layouts/boilerplate") %>
<body>
    <h2>All Listings</h2>
    <!-- <form method="GET" action="/listings/new">
        <button>Create new Listing</button>
    </form> -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">

    <% for(let list of allListings){ %>
    <div class="col-md-4 mb-4">
    <a href="/listings/<%= list._id %>" class="listing-links">
        <div class="card listing-card">
            <img src="<%= list.image.url %>" class="card-img-top listing-img" alt="listing_image">

            <div class="card-body">
                <p class="card-text">
                    <%= list.title %><br>
                   <% if(list.price != null){ %>
                        <strong>&#8377; <%= list.price.toLocaleString("en-IN") %></strong> / night
                    <% } else { %>
                        <strong>Price Not Available</strong>
                    <% } %>
                </p>
            </div>
        </div>
        </a>
    </div>

    <% } %>

</div>
    
    
</body>
