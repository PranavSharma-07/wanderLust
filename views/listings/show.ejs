<% layout("/layouts/boilerplate") %>

   <div class="row mt-3">
        <div class="col-8 offset-2">
        
   <h2><b><%= moreData.title %></b></h2>
   </div>

   <div class="card col-6 offset-2">
        <img src="<%=moreData.image.url%>" class="card-img-top show-img" alt="Listing-Image">
        <div class="card-body">
        <p class="card-text">
               <p>Owned By <i>@<%= moreData.owner.username %></i> </p>
                <p> <%= moreData.description %> </p>
                <p> &#8377; <%= moreData.price.toLocaleString("en-IN") %> </p>
                <p><%= moreData.location %></p>
                <p><%= moreData.country %></p>
        </p>
   </div>
   </div>

   <br><br>
   <% if(currUser && moreData.owner._id.equals(currUser._id)) { %>
   <div class="btn">
        <a href="/listings/<%= moreData._id %>/edit" class="btn btn-dark">Edit</a><br><br>
        <form method="post" action="/listings/<%= moreData._id %>?_method=DELETE">
                <button class="btn btn-dark">Delete</button>
        </form>   

   </div>
     <% } %>
   <hr>

   <div class="col-8 offset-2 mt-3">
     <% if(currUser) {%>
     <h4>Leave a review</h4>
     <form method="post" action="/listings/<%= moreData._id %>/reviews" novalidate class="needs-validation">
          <div class="mt-3">
               <lable for="rating" class="form-lable">Rating</lable>
               <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
          </div>
          <div class="mt-3">
               <lable for="comment" class="form-lable">  Comments </lable>
               <textarea name="review[comment]" id="comment" cols="40" rows="7" class="form-control" required></textarea>
               <div class="invalid-feedback">please add some comment for review</div>

          </div>
          <button class="btn btn-dark mb-3">Submit</button>
     </form>
     <% } %>

     <hr>
     <P><B>Guest reviews</B></P>
     <div class="row">
      <% for(review of moreData.reviews) {%>
          <div class="card col-5 mb-3 ms-3">
               <div class="card-body">
                    <%= "⭐".repeat(review.rating) %>
                    <p class="card-text"><%= review.comment %></p>
                    <h6 class="card-title mb-2">-@<%= review.author.username %></h6>
               </div>
               <form method="post" action="/listings/<%= moreData._id %>/reviews/<%= review._id %>?_method=delete">
                    <button class="btn btn-dark btn-sm mb-3">Delete</button>
               </form>
          </div>
          <% } %>
          </div>
   </div>
        
     </div>